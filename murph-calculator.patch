+.mc-field{margin-bottom:18px}
+.mc-field label{display:block;font-size:15px;line-height:1.3;font-weight:600;margin-bottom:3px}
+.mc-help{font-size:13px;line-height:1.4;color:var(--muted);margin-bottom:7px}
+.mc-row{display:flex;align-items:center;gap:10px}
+.mc-row input{flex:1;min-width:0;font:400 17px/1.3 "Inter",system-ui,sans-serif;color:var(--ink);background:var(--field);border:1px solid var(--field-line);border-radius:12px;padding:11px 14px}
+.mc-row input:focus,.mc-form input:focus{outline:2px solid var(--blue-hi);outline-offset:1px;border-color:transparent}
+.mc-unit{flex:0 0 auto;min-width:44px;font-size:15px;color:var(--muted)}
+.mc-result{margin-top:auto;padding-top:20px;border-top:1px solid var(--line)}
+.mc-rlabel{font-size:14px;color:var(--muted);margin-bottom:4px}
+.mc-big{font-size:48px;line-height:1.05;letter-spacing:-.03em;font-weight:800;overflow-wrap:anywhere}
+.mc-detail{font-size:16px;line-height:1.4;color:var(--soft);margin-top:8px}
+.mc-note{font-size:13px;line-height:1.45;color:var(--muted);margin-top:12px}
+.mc-example{font-size:13px;color:var(--muted);margin:14px 2px 0}
+.mc-summary{margin:28px 0 0;padding:20px 24px;border:1px solid var(--line);border-radius:18px;background:var(--card);font-size:18px;line-height:1.45;color:var(--soft)}
