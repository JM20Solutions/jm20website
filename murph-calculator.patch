+.mc-done{display:none;text-align:left;max-width:640px}
+.mc-done h2{margin-bottom:8px}
+footer{max-width:980px;margin:0 auto;padding:30px 24px 60px;color:var(--muted);font-size:13px;border-top:1px solid var(--line)}
+footer a{color:var(--muted)}
+@media (max-width:820px){.mc-grid{grid-template-columns:1fr}.mc-form{grid-template-columns:1fr}.mc-big{font-size:40px}.mc-leak,.mc-cta{padding:22px 18px}.hide-sm{display:none}}
