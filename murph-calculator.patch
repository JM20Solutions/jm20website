+.mc-dek{font-size:20px;color:var(--soft);line-height:1.5;margin:0 0 36px;max-width:720px}
+.mc-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:stretch}
+.mc-leak{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:28px;display:flex;flex-direction:column}
