+.mc-cta{margin:40px 0 0;padding:32px;border:1px solid var(--line);border-radius:18px;background:var(--card)}
+.mc-cta h2{font-size:28px;line-height:1.15;letter-spacing:-.02em;margin:0 0 10px;font-weight:700}
+.mc-cta>p{font-size:16px;line-height:1.5;color:var(--soft);margin:0 0 22px;max-width:640px}
