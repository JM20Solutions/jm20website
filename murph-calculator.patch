+.brand .jm{color:#c76b45}.brand .num{color:var(--blue-hi)}
+.bar nav{display:flex;gap:22px;align-items:center;font-size:14px}
+.bar nav a{color:var(--muted);text-decoration:none}
+.bar nav a:hover{color:var(--ink)}
+.bar .cta{color:#fff;background:var(--blue);padding:8px 16px;border-radius:980px;font-weight:600}
+.mc-main{max-width:980px;margin:0 auto;padding:56px 24px 40px}
